// Task 4 dev fixture — FOCUSED SUBSET of openfront/schema.prisma @ 2b7181a.
//
// This is NOT a schema we migrate. It exists only so a committed script can
// seed a local dev catalog through the same tables Openfront reads, without
// depending on the gitignored upstream clone's node_modules.
//
// Rules:
//  - Keep model/field names, @@/ @map names, relation names and enum labels
//    byte-identical to openfront/schema.prisma, or writes land in the wrong
//    table/column.
//  - Add a model here only when the seeder actually writes it.
//  - Never run `prisma migrate` from this directory.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/openfront-db"
}

datasource db {
  provider = "postgresql"
  url      = env("OPENFRONT_DATABASE_URL")
}

enum ProductStatusType {
  draft
  proposed
  published
  rejected
}

model Currency {
  id           String        @id @default(cuid())
  code         String        @unique @default("")
  symbol       String        @default("")
  symbolNative String        @default("")
  name         String        @default("")
  moneyAmounts MoneyAmount[] @relation("MoneyAmount_currency")
  regions      Region[]      @relation("Region_currency")
  stores       Store[]       @relation("Currency_stores")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
}

/// Columns we never write are declared optional (`?`) so Prisma omits them from
/// the INSERT and the database default applies. Never "fix" one by adding a
/// literal @default — that would write a value the merchant never chose.
model Store {
  id                  String     @id
  name                String?
  defaultCurrencyCode String?
  homepageTitle       String?
  homepageDescription String?
  currencies          Currency[] @relation("Currency_stores")
}

model Region {
  id        String    @id @default(cuid())
  code      String    @unique @default("")
  name      String    @default("")
  taxRate   Float
  taxCode   String    @default("")
  currency  Currency? @relation("Region_currency", fields: [currencyId], references: [id])
  currencyId String?  @map("currency")
  countries Country[] @relation("Country_region")
  moneyAmounts MoneyAmount[] @relation("MoneyAmount_region")
}

model Country {
  id          String  @id @default(cuid())
  iso2        String  @unique @default("")
  iso3        String  @default("")
  numCode     Int
  name        String  @default("")
  displayName String  @default("")
  region      Region? @relation("Country_region", fields: [regionId], references: [id])
  regionId    String? @map("region")
}

model Product {
  id                 String              @id @default(cuid())
  title              String              @default("")
  description        Json                @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  handle             String              @unique @default("")
  subtitle           String              @default("")
  isGiftcard         Boolean             @default(false)
  metadata           Json?
  discountable       Boolean             @default(true)
  status             ProductStatusType   @default(draft)
  externalId         String              @default("")
  productCollections ProductCollection[] @relation("Product_productCollections")
  /// Task 22, Step 4 — catalog media. Declared here because
  /// `scripts/seed-catalog.ts` writes it; the relation name and the implicit
  /// join table `_Product_productImages` must stay identical to upstream.
  productImages      ProductImage[]      @relation("Product_productImages")
  productVariants    ProductVariant[]    @relation("ProductVariant_product")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
}

/// Upstream `ProductImage`, minus the relations this seeder never writes
/// (`productVariants` / `ProductVariant.primaryImage`). Every column name, type
/// and default matches `openfront/schema.prisma`.
///
/// `image_*` columns describe an UPLOADED asset handled by the commerce
/// backend's storage provider. The production catalog has no uploaded asset, so
/// it writes only `imagePath` (a root-relative URL this deployment serves) plus
/// the measured facts about that file (`width`, `height`, `filesize`,
/// `extension`) and the licence record in `metadata`. `image_id` is left null on
/// purpose: setting it would make the backend advertise a URL for a file that
/// does not exist in its storage.
model ProductImage {
  id              String   @id @default(cuid())
  image_id        String?
  image_filesize  Int?
  image_width     Int?
  image_height    Int?
  image_extension String?
  imagePath       String   @default("")
  altText         String   @default("")
  order           Int?     @default(0)
  metadata        Json?
  products        Product[] @relation("Product_productImages")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model ProductCollection {
  id        String    @id @default(cuid())
  title     String    @default("")
  handle    String    @unique @default("")
  metadata  Json?
  products  Product[] @relation("Product_productCollections")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model ProductVariant {
  id                String        @id @default(cuid())
  title             String        @default("")
  sku               String        @default("")
  inventoryQuantity Int
  allowBackorder    Boolean       @default(false)
  manageInventory   Boolean       @default(true)
  /// Task 22, Step 3 — the fulfillment record for this sellable variant: either
  /// a 1:1 supplier SKU mapping or an explicit manual-fulfillment rule. Written
  /// by `scripts/seed-catalog.ts` from `scripts/catalog/fulfillment.ts`, so the
  /// mapping is auditable in the database and not only in a file.
  metadata          Json?
  variantRank       Int?          @default(0)
  product           Product?      @relation("ProductVariant_product", fields: [productId], references: [id])
  productId         String?       @map("product")
  prices            MoneyAmount[] @relation("MoneyAmount_productVariant")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
}

model MoneyAmount {
  id               String          @id @default(cuid())
  amount           Int
  compareAmount    Int?
  productVariant   ProductVariant? @relation("MoneyAmount_productVariant", fields: [productVariantId], references: [id])
  productVariantId String?         @map("productVariant")
  region           Region?         @relation("MoneyAmount_region", fields: [regionId], references: [id])
  regionId         String?         @map("region")
  currency         Currency?       @relation("MoneyAmount_currency", fields: [currencyId], references: [id])
  currencyId       String?         @map("currency")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
}