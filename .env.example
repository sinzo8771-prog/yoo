# Production stack environment (Task 24) â€” canonical tracked copy.
# Copy to the repo ROOT as `.env` and fill in. docker-compose.prod.yml reads it
# automatically. NEVER commit the real `.env` (root .gitignore covers `.env`;
# the CI security job fails if any `.env*` ever becomes tracked).
#
#   cp .env.example .env
#
# Rules that the stack ENFORCES with `:?` (compose refuses to start without):
#   - POSTGRES_PASSWORD, SESSION_SECRET, OPENSHIP_SESSION_SECRET,
#     OAUTH_STATE_SECRET, NEXT_PUBLIC_BACKEND_URL, NEXT_PUBLIC_SITE_URL,
#     all five S3_* keys, STORE_DOMAIN/API_DOMAIN (edge profile only).

# â”€â”€ Secrets (generate each one separately, never reuse a value) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# URL-safe characters only (it is embedded in DATABASE_URL below).
POSTGRES_PASSWORD="replace-with-random-64-char-hex"

# Cart-proof signing secret for the STORE â†” OPENFRONT pair (Task 4/9 invariant:
# byte-identical on both sides or every guest cart write fails "Cart not found").
# If store/.env already exists (local workstation), copy ITS SESSION_SECRET here
# so host-run e2e scripts and the containers agree. â‰¥32 chars.
SESSION_SECRET="replace-with-random-64-char-hex"

# OpenShip signs its own dashboard sessions with a SEPARATE secret â€” a distinct
# trust domain from the cart-proof pair (per-app secrets, env-templates rule).
OPENSHIP_SESSION_SECRET="replace-with-random-64-char-hex"

# OpenShip OAuth state signing (csrf protection for the Shopify/Shop install
# flow). Distinct from both secrets above.
OAUTH_STATE_SECRET="replace-with-random-64-char-hex"

# â”€â”€ Public origins (baked into browser bundles AT BUILD TIME) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Production: the public HTTPS origins served by the Caddy edge.
#   NEXT_PUBLIC_BACKEND_URL = https://api.example.com   (GraphQL {BASE}/api/graphql)
#   NEXT_PUBLIC_SITE_URL    = https://shop.example.com
# Changing either REQUIRES rebuilding the store/openfront images (Â§6 of
# deployment.md). For a compose-internal rehearsal where no domain exists yet,
# use NEXT_PUBLIC_BACKEND_URL="http://openfront:3001" (resolvable ONLY inside
# the compose network â€” do not use that value for anything a browser touches).
NEXT_PUBLIC_BACKEND_URL="https://api.example.com"
NEXT_PUBLIC_SITE_URL="https://shop.example.com"
NEXT_PUBLIC_DEFAULT_REGION="us"

# â”€â”€ Edge (Caddy) â€” required when running with `--profile edge` â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Bare hostnames, no scheme; Caddy obtains/renews Let's Encrypt certificates
# for these automatically once DNS A/AAAA records point at this host.
STORE_DOMAIN="shop.example.com"
API_DOMAIN="api.example.com"

# â”€â”€ Openship dashboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public origin of the OpenShip admin. It is NOT proxied by Caddy (loopback +
# SSH tunnel only); the default below is correct unless you intentionally
# publish it elsewhere.
OPENSHIP_PUBLIC_URL="http://localhost:3002"

# â”€â”€ Openfront storage (productionEnv() THROWS in production if any is absent) â”€
# Placeholders are accepted and the stack boots without media uploads; set real
# values before uploading product images. Any S3-compatible endpoint works.
S3_BUCKET_NAME="replace-me"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_ENDPOINT="https://s3.example.com"

# â”€â”€ Storefront public flags â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
HIDE_OPENFRONT_BRANDING="true"
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
# Extra image hosts the Next optimizer may fetch (comma/space separated
# origins), on top of NEXT_PUBLIC_BACKEND_URL and S3_ENDPOINT (lib/media/images.ts).
NEXT_PUBLIC_IMAGE_HOSTS=""

# â”€â”€ Payment public keys (Step 10 â€” after the synthetic gate passes) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# PUBLIC keys only; private keys belong to openfront, never to the store.
NEXT_PUBLIC_STRIPE_KEY=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_PAYPAL_SANDBOX="true"

# â”€â”€ Backups â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# postgres-backup sidecar keeps this many days of pg_dump archives in ./backups.
BACKUP_KEEP_DAYS="7"

# â”€â”€ Deploy tagging (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Images are built as yoo-{openfront,openship,store}:${DEPLOY_TAG:-latest};
# rollback.md relies on :latest/:previous retagging.
# DEPLOY_TAG="latest"
