# Openfront Storefront — environment template (code-verified 2026-09-14 @ 9b1a431)
# Copy to .env and fill in. NEVER commit real .env files.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL of your Openfront backend instance (GraphQL at {BASE}/api/graphql).
# Run the storefront on port 3002 locally (PORT=3002).
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# ── Optional ────────────────────────────────────────────────────────────────
# Default region code for the [countryCode] route prefix (default: "us")
NEXT_PUBLIC_DEFAULT_REGION="us"
# Set "true" to hide Openfront branding
HIDE_OPENFRONT_BRANDING="false"

# Payment provider PUBLIC keys only (client-side)
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
# PayPal sandbox toggle (default true)
# NEXT_PUBLIC_PAYPAL_SANDBOX="true"

# ⚠️ SECURITY (recon finding): this codebase references STRIPE_SECRET_KEY /
# STRIPE_WEBHOOK_SECRET / PAYPAL_CLIENT_SECRET / PAYPAL_WEBHOOK_ID in a few
# leftover spots. Do NOT set private/server-only credentials in the storefront —
# payment secrets belong to the Openfront backend. Payment provider choice and
# payment sessions are managed server-side by Openfront.
