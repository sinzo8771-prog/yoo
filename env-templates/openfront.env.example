# Openfront — environment template (code-verified 2026-09-14 @ 2b7181a)
# Copy to .env and fill in. NEVER commit real .env files.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection (throws at boot if missing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openfront"

# Session/token signing secret — MUST be at least 32 characters
# (enforced in features/keystone/index.ts)
SESSION_SECRET="generate-a-random-64-char-hex-string-here-please-change"

# ── Public app config ───────────────────────────────────────────────────────
# Canonical public origin of THIS app. Used for OAuth callback origin checks
# and OpenShip integration advertising. In production this must be the HTTPS domain.
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
# Dashboard route ordering (comma-separated view keys) — optional
# NEXT_PUBLIC_VIEW_ORDER=""
# Default region code for storefront routing
NEXT_PUBLIC_DEFAULT_REGION="us"
# Set "true" to hide Openfront branding in the storefront
# HIDE_OPENFRONT_BRANDING="false"
# Allow public self-signup on the dashboard (default: off)
# PUBLIC_SIGNUPS_ALLOWED="false"
# Comma-separated list of trusted reverse-proxy IPs for client IP resolution
# TRUSTED_PROXY_IPS=""
# Customer session token lifetime in days (default 90)
# CUSTOMER_TOKEN_MAX_AGE_DAYS="90"

# ── Secrets / crypto (server-only) ──────────────────────────────────────────
# Optional dedicated pepper for token/credential crypto (falls back to SESSION_SECRET).
# Must be ≥32 chars when set.
# CREDENTIAL_PEPPER=""

# ── Stripe (optional payment provider) ──────────────────────────────────────
# Publishable key: NEXT_PUBLIC_STRIPE_KEY (or STRIPE_PUBLISHABLE_KEY)
# NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── PayPal (optional payment provider) ──────────────────────────────────────
# Client id is public; secret + webhook id are server-only.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
# NEXT_PUBLIC_PAYPAL_SANDBOX="true"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"

# ── Shipping providers ──────────────────────────────────────────────────────
# NOTE (recon finding): ShipEngine/Shippo adapters do NOT read API keys from env
# in the current source — credentials are configured per-provider in DB
# (FulfillmentProvider records via the dashboard). Keep provider credentials out
# of env; the vars below are documented only if a future revision reads them.
# SHIPPO_API_KEY=""
# SHIPENGINE_API_KEY=""

# ── File storage (REQUIRED for production builds) ───────────────────────────
# ⚠️ Recon finding: features/keystone/index.ts productionEnv() THROWS at module
# evaluation when NODE_ENV=production (i.e. `next build` / CI) and any of these
# is unset — even if you don't use S3. For local/CI builds without real storage,
# set placeholder values (e.g. bucket "local-placeholder-bucket"). In production,
# these must point at real S3-compatible storage for product/claim media.
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_BUCKET_NAME="local-placeholder-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="local-placeholder"
S3_SECRET_ACCESS_KEY="local-placeholder"

# Cloudinary is currently commented out in the source (ClaimImage model).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_KEY=""
# CLOUDINARY_SECRET=""

# ── Email / SMTP (server-only) ──────────────────────────────────────────────
# Exact names read by features/keystone/lib/mail.ts:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourstore.com"
# Public store link used in email CTAs/buttons
SMTP_STORE_LINK="http://localhost:3002"
# Optional: set to an Ethereal user to log preview URLs for test emails
# MAIL_USER="ethereal-user@ethereal.email"

# ── AI features (optional, dashboard/completion) ────────────────────────────
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=""
# OPENROUTER_MAX_TOKENS=""
