# Custom storefront (`store/`) — environment template
# Copy to store/.env and fill in. NEVER commit real .env files.
# Canonical tracked copy: env-templates/store.env.example

# ── Required ────────────────────────────────────────────────────────────
# Public URL of the Openfront backend (GraphQL lives at {BASE}/api/graphql).
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# ─ Optional ─────────────────────────────────────────────────────────────
# Default region code for the [countryCode] route prefix (default: "us")
NEXT_PUBLIC_DEFAULT_REGION="us"
# Set "true" to hide Openfront branding in the storefront chrome
HIDE_OPENFRONT_BRANDING="true"

# Payment provider PUBLIC keys only (client-side). Private keys belong to
# Openfront, never to the storefront.
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
# NEXT_PUBLIC_PAYPAL_SANDBOX="true"

# ── Dev fixture (Task 4) — seeder only ───────────────────────────────────
# Point at the Openfront database so `npm run seed:dev` can insert the
# namespaced `devfix_*` dev catalog. Never set this in production; the
# storefront itself never reads it at runtime.
OPENFRONT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openfront"

# Catalog read cache TTL in ms (default 30000, hard max 300000, 0 disables).
# Keep it short: prices and availability must never go stale.
# OPENFRONT_CACHE_TTL_MS="30000"