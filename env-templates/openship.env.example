# OpenShip — environment template (code-verified 2026-09-14 @ 04b231d)
# Copy to .env and fill in. NEVER commit real .env files.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection. FALLBACK WARNING: features/keystone/index.ts falls back
# to a local SQLite file (file:./keystone.db) when unset — always set this so you
# don't silently develop against SQLite.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openship"

# Session secret. FALLBACK WARNING: falls back to an insecure testing string when
# unset — always set a real value (features/keystone/index.ts).
# Enforced style elsewhere in the ecosystem: ≥32 characters.
SESSION_SECRET="generate-a-random-64-char-hex-string-here-please-change"

# ── Public app config ───────────────────────────────────────────────────────
# Canonical public origin of THIS app (webhook-security.ts, platform base URLs).
# Run this app on port 3001 locally (PORT=3001) so Openfront (3000) is free.
NEXT_PUBLIC_URL="http://localhost:3001"
# Dashboard route ordering (comma-separated view keys) — optional
# NEXT_PUBLIC_VIEW_ORDER=""
# Allow public self-signup on the dashboard (default: off)
# PUBLIC_SIGNUPS_ALLOWED="false"

# ── OAuth state (server-only) ───────────────────────────────────────────────
# Signs OAuth state cookies for shop/channel connects. Falls back to an insecure
# development constant when unset — set a real value (≥32 chars).
OAUTH_STATE_SECRET="generate-another-random-64-char-hex-string-change-me"

# ── Shop integrations (server-only) ─────────────────────────────────────────
SHOPIFY_APP_KEY="your-shopify-app-key"
SHOPIFY_APP_SECRET="your-shopify-app-secret"

# ── Email / SMTP (server-only) ──────────────────────────────────────────────
# Exact names read by features/keystone/lib/mail.ts:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="no-reply@yourdomain.com"
SMTP_STORE_LINK="http://localhost:3001"
# Optional: Ethereal test-email preview
# MAIL_USER="ethereal-user@ethereal.email"

# ── AI features (optional, dashboard/completion) ────────────────────────────
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=""
# OPENROUTER_MAX_TOKENS=""
